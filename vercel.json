{
  "crons": [
    {
      "path": "/api/cron/inbox?job=sync",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/inbox?job=process",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/inbox?job=digest",
      "schedule": "0 14 * * 1"
    },
    {
      "path": "/api/cron/inbox?job=health",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/inbox?job=retention",
      "schedule": "0 10 * * *"
    }
  ]
}
