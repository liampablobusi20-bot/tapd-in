NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser. Used exclusively for guest
# (token-based, no-login) access, which bypasses RLS by design and instead
# validates the guest's token/permission in application code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
